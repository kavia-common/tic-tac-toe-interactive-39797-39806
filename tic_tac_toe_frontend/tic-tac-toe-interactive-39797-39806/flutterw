#!/usr/bin/env bash
# Wrapper to run Flutter commands in the correct project directory.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$DIR/tic_tac_toe_frontend"

if [ ! -f "$APP_DIR/pubspec.yaml" ]; then
  echo "Error: Flutter project not found at $APP_DIR" >&2
  exit 1
fi

cd "$APP_DIR"
exec flutter "$@"
